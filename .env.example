# Contact form + newsletter (Resend) — https://resend.com
RESEND_API_KEY=re_xxxxxxxx
CONTACT_TO_EMAIL=info@geoffreyrcrawford.com
# Must be an address on a domain verified in Resend. onboarding@resend.dev only delivers to the account owner.
CONTACT_FROM_EMAIL=info@geoffreyrcrawford.com

# Newsletter only. Legacy Resend Audience id for /api/subscribe.
# When set, the newsletter adds contacts with the Audiences API.
# When unset, newsletter signups are emailed to the inbox instead.
# The kit does not use this variable.
RESEND_AUDIENCE_ID=

# First Lead Campaign Kit only. Resend Segment id for /api/first-lead-campaign/opt-in.
# Create a segment named "First Lead Campaign Kit" and paste its id here. Server-only.
RESEND_KIT_SEGMENT_ID=

# Google Analytics — https://analytics.google.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------------
# Workspace / accounts (Supabase) — https://supabase.com  [OPTIONAL]
# Leave these blank and the workspace shows a clean "coming soon" state; the
# free Campaign Builder keeps working with no account. Set all three to turn on
# accounts, saved campaign history, and the /app dashboard.
#
# Find them in Supabase → Project Settings → API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose this to the client / commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: AI-generated campaign plans (falls back to rules if unset).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Former Gumroad checkout for /first-lead-campaign. The page is now a free kit opt-in
# and does not use this URL.
# Kit delivery requires RESEND_API_KEY, CONTACT_FROM_EMAIL, and RESEND_KIT_SEGMENT_ID.
# Private files: connect a private Vercel Blob store. Vercel then sets
# BLOB_STORE_ID, VERCEL_OIDC_TOKEN, and BLOB_WEBHOOK_PUBLIC_KEY.
# BLOB_READ_WRITE_TOKEN is not required for code running on Vercel.
# Upload pathnames: first-lead-campaign/First-Lead-Campaign-Kit-Guide.pdf
# and first-lead-campaign/First-Lead-Campaign-Kit-Workbook.xlsx
FIRST_LEAD_CAMPAIGN_CHECKOUT_URL=

# Server-only. Powers the short example on /first-lead-campaign.
# Never expose this in the browser, NEXT_PUBLIC variables, or logs.
ANTHROPIC_API_KEY=
